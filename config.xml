<?xml version='1.0' encoding='utf-8'?>
<widget id="app.west2romaji" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>West2Romaji</name>
    <description>Translate any written language into Japanese romaji.</description>
    <author href="https://www.youtube.com/@CJCloudAI">CJCloudAI</author>
    <content src="index.html" />
    <access origin="https://api.x.ai" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="https://api.x.ai/*" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="EnableViewportScale" value="false" />
    <preference name="BackgroundColor" value="#E6EEF8" />
    <preference name="Orientation" value="portrait" />
    <preference name="scheme" value="app" />
    <preference name="hostname" value="localhost" />
    <preference name="AllowBackForwardNavigationGestures" value="false" />
    <preference name="InspectableWebview" value="true" />
    <preference name="StatusBarOverlaysWebView" value="true" />
    <preference name="StatusBarStyle" value="default" />
    <preference name="deployment-target" value="15.0" />
    <plugin name="cordova-plugin-secure-storage-echo" spec="^5.1.1" />
    <plugin name="cordova-plugin-advanced-http" spec="^3.3.1" />
    <plugin name="cordova-plugin-file" spec="^8.1.3" />
    <plugin name="cordova-plugin-network-information" spec="^3.0.0" />
    <plugin name="cordova-plugin-statusbar" spec="^4.0.0" />
    <plugin name="cordova-plugin-device" spec="^3.0.0" />
    <plugin name="cordova-plugin-taptic-engine" spec="^2.2.0" />
    <engine name="ios" spec="^8.1.1" />
    <hook src="hooks/strip-private-ios-header.js" type="after_prepare" />
    <platform name="ios">
        <preference name="deployment-target" value="15.0" />
        <preference name="KeychainAccessibility" value="WhenUnlockedThisDeviceOnly" />
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <icon height="1024" src="res/icon/ios/icon-1024.png" width="1024" />
        <icon height="20" src="res/icon/ios/icon-20.png" width="20" />
        <icon height="40" src="res/icon/ios/icon-20@2x.png" width="40" />
        <icon height="60" src="res/icon/ios/icon-20@3x.png" width="60" />
        <icon height="29" src="res/icon/ios/icon-29.png" width="29" />
        <icon height="58" src="res/icon/ios/icon-29@2x.png" width="58" />
        <icon height="87" src="res/icon/ios/icon-29@3x.png" width="87" />
        <icon height="40" src="res/icon/ios/icon-40.png" width="40" />
        <icon height="80" src="res/icon/ios/icon-40@2x.png" width="80" />
        <icon height="120" src="res/icon/ios/icon-40@3x.png" width="120" />
        <icon height="120" src="res/icon/ios/icon-60@2x.png" width="120" />
        <icon height="180" src="res/icon/ios/icon-60@3x.png" width="180" />
        <icon height="76" src="res/icon/ios/icon-76.png" width="76" />
        <icon height="152" src="res/icon/ios/icon-76@2x.png" width="152" />
        <icon height="167" src="res/icon/ios/icon-83.5@2x.png" width="167" />
    </platform>
</widget>
